<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Alles verschlüsselt, nur der Titelbild-Server darf notfalls unverschlüsselt (er bietet beides an). -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">thumbnails.libretro.com</domain>
    </domain-config>
</network-security-config>
